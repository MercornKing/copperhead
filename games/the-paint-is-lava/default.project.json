{
  "name": "ThePaintIsLava",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "LoadCharacterAppearance": false,
        "CharacterUseJumpPower": true,
        "CharacterJumpPower": 55,
        "CharacterWalkSpeed": 20
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$path": "src/character"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -100,
        "StreamingEnabled": false
      }
    },
    "Teams": {
      "$className": "Teams"
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    }
  }
}
